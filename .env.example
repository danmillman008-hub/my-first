DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
# Optional: enables LLM rewriting of the deterministic explanation (server-side only)
TUTOR_LLM_API_KEY=
TUTOR_LLM_MODEL=gemini-2.0-flash
# Optional: require this key (x-api-key / Bearer) on the tutor MCP HTTP endpoint (/mcp)
TUTOR_MCP_API_KEY=
# Optional: require this key on Graphify's own MCP HTTP server
GRAPHIFY_API_KEY=
# Optional tuning
TUTOR_BRANCH_HALF_LIFE_MS=604800000
